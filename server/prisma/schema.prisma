// ======================================================
// MODULE 6 - PAYMENT & FINANCIAL MANAGEMENT
// ENUMS
// ======================================================

enum PaymentMethod {
  COD
  UPI
  CARD
  NET_BANKING
  WALLET

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum PaymentGateway {
  RAZORPAY
  CASH

  @@map("payment_gateway")
}

enum PaymentTransactionStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED

  @@map("payment_transaction_status")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("refund_status")
}

enum FinancialDocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE

  @@map("financial_document_type")
}

// ======================================================
// PAYMENTS
// ======================================================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  orderId String @unique @map("order_id") @db.Uuid

  // Payment Details
  paymentMethod PaymentMethod  @map("payment_method")
  paymentStatus PaymentStatus  @default(PENDING) @map("payment_status")
  gateway       PaymentGateway

  // Amounts
  payableAmount  Decimal @map("payable_amount") @db.Decimal(10, 2)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(10, 2)
  refundedAmount Decimal @default(0) @map("refunded_amount") @db.Decimal(10, 2)

  currency String @default("INR") @db.VarChar(10)

  paidAt DateTime? @map("paid_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  transactions PaymentTransaction[]

  refunds Refund[]

  webhooks PaymentWebhook[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([gateway])
  @@index([paidAt])
  @@map("payments")
}

// ======================================================
// PAYMENT TRANSACTIONS
// ======================================================

model PaymentTransaction {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  paymentId String @map("payment_id") @db.Uuid

  // Gateway Details
  gateway PaymentGateway

  gatewayOrderId   String? @map("gateway_order_id") @db.VarChar(255)
  gatewayPaymentId String? @map("gateway_payment_id") @db.VarChar(255)
  gatewaySignature String? @map("gateway_signature") @db.VarChar(500)

  // Transaction Status
  transactionStatus PaymentTransactionStatus @default(INITIATED) @map("transaction_status")

  // Amount
  amount Decimal @db.Decimal(10, 2)

  currency String @default("INR") @db.VarChar(10)

  // Gateway Response
  gatewayResponse Json? @map("gateway_response")

  failureReason String? @map("failure_reason") @db.Text

  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([gateway, gatewayPaymentId])
  @@index([paymentId])
  @@index([transactionStatus])
  @@index([gateway])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([processedAt])
  @@map("payment_transactions")
}

// ======================================================
// REFUNDS
// ======================================================

model Refund {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  paymentId String @map("payment_id") @db.Uuid

  // Refund Details
  refundAmount Decimal @map("refund_amount") @db.Decimal(10, 2)

  refundStatus RefundStatus @default(PENDING) @map("refund_status")

  gatewayRefundId String? @map("gateway_refund_id") @db.VarChar(255)

  refundReason String? @map("refund_reason") @db.Text

  gatewayResponse Json? @map("gateway_response")

  refundedAt DateTime? @map("refunded_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([paymentId])
  @@index([refundStatus])
  @@index([gatewayRefundId])
  @@index([refundedAt])
  @@map("refunds")
}

// ======================================================
// PAYMENT WEBHOOKS
// ======================================================

model PaymentWebhook {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  paymentId String @map("payment_id") @db.Uuid

  // Gateway Event
  gatewayEventId String @map("gateway_event_id") @db.VarChar(255)

  eventType String @map("event_type") @db.VarChar(100)

  payload Json

  // Processing
  isProcessed Boolean @default(false) @map("is_processed")

  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  processingError String? @map("processing_error") @db.Text

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([gatewayEventId])
  @@index([paymentId])
  @@index([eventType])
  @@index([isProcessed])
  @@index([processedAt])
  @@map("payment_webhooks")
}

// ======================================================
// FINANCIAL DOCUMENTS
// ======================================================

model FinancialDocument {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  orderId String @map("order_id") @db.Uuid

  // Document Details
  documentType FinancialDocumentType @map("document_type")

  documentNumber String @unique @map("document_number") @db.VarChar(100)

  pdfKey String @map("pdf_key") @db.VarChar(500)

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([orderId])
  @@index([documentType])
  @@index([generatedAt])
  @@map("financial_documents")
}
