generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}


// ======================================================
// MODULE 1 - IDENTITY & ACCESS MANAGEMENT
// ENUMS
// ======================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING_VERIFICATION

  @@map("user_status")
}

enum OTPPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  PHONE_VERIFICATION
  EMAIL_VERIFICATION

  @@map("otp_purpose")
}

enum OTPChannel {
  SMS
  EMAIL

  @@map("otp_channel")
}

enum AuthProvider {
  LOCAL
  GOOGLE

  @@map("auth_provider")
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  WEB

  @@map("device_type")
}

enum RevocationReason {
  LOGOUT
  PASSWORD_CHANGED
  TOKEN_ROTATED
  ACCOUNT_LOCKED
  SECURITY
  EXPIRED

  @@map("revocation_reason")
}

// ======================================================
// ROLES
// ======================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  // Indexes
  @@index([isActive])
  @@map("roles")
}

// ======================================================
// PERMISSIONS
// ======================================================

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  // Indexes
  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

// ======================================================
// ROLE PERMISSIONS
// ======================================================

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([roleId, permissionId])
  // Indexes
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ======================================================
// USERS
// ======================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  // Role
  roleId String @map("role_id") @db.Uuid

  // Basic Information
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)

  // Authentication
  phone        String  @db.VarChar(15)
  email        String? @db.VarChar(255)
  passwordHash String  @map("password_hash") @db.VarChar(255)

  // Account Status
  status UserStatus @default(PENDING_VERIFICATION)

  // Verification
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  // Security
  passwordChangedAt   DateTime? @map("password_changed_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // Login Activity
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(45)
  lastSeenAt  DateTime? @map("last_seen_at")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ======================================================
  // Relations
  // ======================================================

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  addresses        Address[]
  otpVerifications OTPVerification[]
  authProviders    UserAuthProvider[]
  sessions         UserSession[]

  // ======================================================
  // MODULE 2 - STORE RELATIONS
  // ======================================================

  ownedStore     Store?  @relation("StoreOwner")
  verifiedStores Store[] @relation("StoreVerifier")

  // ======================================================
  // Indexes
  // ======================================================
  carts     Cart[]
  wishlists Wishlist[]
  orders    Order[]

  @@unique([phone])
  @@unique([email])
  @@index([roleId])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("users")
}

// ======================================================
// ADDRESSES
// ======================================================

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  label String? @db.VarChar(50)

  receiverName  String @map("receiver_name") @db.VarChar(100)
  receiverPhone String @map("receiver_phone") @db.VarChar(15)

  houseNo  String  @map("house_no") @db.VarChar(100)
  street   String? @db.VarChar(255)
  area     String  @db.VarChar(255)
  landmark String? @db.VarChar(255)

  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  country String @db.VarChar(100)
  pincode String @db.VarChar(10)

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  isDefault Boolean @default(false) @map("is_default")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================
  orders Order[]

  @@index([userId])
  @@index([city])
  @@index([pincode])
  @@map("addresses")
}

// ======================================================
// OTP VERIFICATIONS
// ======================================================

model OTPVerification {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  purpose OTPPurpose
  channel OTPChannel

  destination String @db.VarChar(255)

  otpHash String @map("otp_hash") @db.VarChar(255)

  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")

  lastAttemptAt DateTime? @map("last_attempt_at")
  blockedUntil  DateTime? @map("blocked_until")

  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ======================================================
  // Relations
  // ======================================================

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([purpose])
  @@index([channel])
  @@index([destination])
  @@index([expiresAt])
  @@map("otp_verifications")
}

// ======================================================
// USER AUTH PROVIDERS
// ======================================================

model UserAuthProvider {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  provider AuthProvider

  providerUserId String? @map("provider_user_id") @db.VarChar(255)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([provider])
  @@map("user_auth_providers")
}

// ======================================================
// USER SESSIONS
// ======================================================

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  deviceType DeviceType @map("device_type")

  deviceName String? @map("device_name") @db.VarChar(255)

  deviceId String? @map("device_id") @db.VarChar(255)

  ipAddress String? @map("ip_address") @db.VarChar(45)

  userAgent String? @map("user_agent") @db.Text

  lastActivityAt DateTime @map("last_activity_at")

  expiresAt DateTime @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("user_sessions")
}

// ======================================================
// REFRESH TOKENS
// ======================================================

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String @map("session_id") @db.Uuid

  tokenHash String @map("token_hash") @db.VarChar(255)

  revokedReason RevocationReason? @map("revoked_reason")

  revokedAt DateTime? @map("revoked_at")

  expiresAt DateTime @map("expires_at")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ======================================================
  // Relations
  // ======================================================

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([tokenHash])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

// =========================================
// MODULE 2 ENUMS (Merchant & Store)
// =========================================

enum StoreStatus {
  PENDING
  ACTIVE
  TEMPORARILY_CLOSED
  SUSPENDED
  CLOSED

  @@map("store_status")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("week_day")
}

// =========================================
// MODULE 2 - STORE
// =========================================

model Store {
  id String @id @default(uuid()) @db.Uuid

  // Ownership
  ownerId String @unique @map("owner_id") @db.Uuid
  owner   User   @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Basic Information
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String? @db.Text

  // Contact Information
  phone String  @unique @db.VarChar(15)
  email String? @unique @db.VarChar(255)

  // Business Information
  gstNumber                  String? @unique @map("gst_number") @db.VarChar(20)
  businessRegistrationNumber String? @unique @map("business_registration_number") @db.VarChar(50)

  // Store Images
  logoKey   String? @map("logo_key") @db.VarChar(500)
  bannerKey String? @map("banner_key") @db.VarChar(500)

  // Address
  addressLine1 String  @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)

  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  country String @db.VarChar(100)
  pincode String @db.VarChar(20)

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  timezone String @default("Asia/Kolkata") @db.VarChar(100)

  // Status: Platform/Admin lifecycle (ACTIVE, SUSPENDED, CLOSED, PENDING)
  status             StoreStatus        @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  verifiedById String? @map("verified_by_id") @db.Uuid
  verifiedBy   User?   @relation("StoreVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  // Real-time Merchant Override: Manual toggle to temporarily pause orders (e.g. rush hours)
  isOpen Boolean @default(false) @map("is_open")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  images          StoreImage[]
  hours           StoreHour[]
  deliverySetting StoreDeliverySetting?
  storeProducts   StoreProduct[]
  carts           Cart[]
  orders          Order[]

  @@index([status])
  @@index([verificationStatus])
  @@index([city])
  @@index([state])
  @@index([pincode])
  @@index([latitude, longitude])
  @@map("stores")
}

// ======================================================
// STORE IMAGES
// ======================================================

model StoreImage {
  id String @id @default(uuid()) @db.Uuid

  // Store
  storeId String @map("store_id") @db.Uuid

  // Image Information
  objectKey String @map("object_key") @db.VarChar(500)

  displayOrder Int @default(1) @map("display_order")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([storeId])
  @@index([displayOrder])
  @@map("store_images")
}

// ======================================================
// STORE HOURS
// ======================================================

model StoreHour {
  id String @id @default(uuid()) @db.Uuid

  // Store
  storeId String @map("store_id") @db.Uuid

  // Business Day
  weekDay WeekDay @map("week_day")

  // Opening Hours
  openingTime DateTime? @map("opening_time") @db.Time(6)
  closingTime DateTime? @map("closing_time") @db.Time(6)

  // Store Availability
  isClosed Boolean @default(false) @map("is_closed")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([storeId, weekDay])
  @@index([storeId])
  @@index([weekDay])
  @@map("store_hours")
}

// ======================================================
// STORE DELIVERY SETTINGS
// ======================================================

model StoreDeliverySetting {
  id String @id @default(uuid()) @db.Uuid

  // Store
  storeId String @unique @map("store_id") @db.Uuid

  // Delivery Configuration
  isDeliveryAvailable Boolean @default(true) @map("is_delivery_available")
  isPickupAvailable   Boolean @default(true) @map("is_pickup_available")

  minimumOrderAmount Decimal @default(0.00) @map("minimum_order_amount") @db.Decimal(10, 2)

  deliveryRadiusKm Decimal @default(5.00) @map("delivery_radius_km") @db.Decimal(5, 2)

  deliveryCharge Decimal @default(0.00) @map("delivery_charge") @db.Decimal(10, 2)

  freeDeliveryAbove Decimal? @map("free_delivery_above") @db.Decimal(10, 2)

  estimatedDeliveryTime Int @default(30) @map("estimated_delivery_time")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([storeId])
  @@map("store_delivery_settings")
}

// ======================================================
// MODULE 3 ENUMS (Catalog & Inventory)
// ======================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED

  @@map("product_status")
}

enum ProductImageType {
  PRIMARY
  GALLERY

  @@map("product_image_type")
}

enum AvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
  DISCONTINUED

  @@map("availability_status")
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  RESTOCK
  ADJUSTMENT
  DAMAGE
  EXPIRED

  @@map("inventory_transaction_type")
}

enum InventoryReferenceType {
  ORDER
  PURCHASE
  RETURN
  MANUAL

  @@map("inventory_reference_type")
}

// ======================================================
// CATEGORIES
// ======================================================

model Category {
  id String @id @default(uuid()) @db.Uuid

  // Hierarchy
  parentCategoryId String? @map("parent_category_id") @db.Uuid

  // Category Information
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(170)
  description String? @db.Text

  imageKey String? @map("image_key") @db.VarChar(500)
  iconKey  String? @map("icon_key") @db.VarChar(500)

  sortOrder Int @default(0) @map("sort_order")

  isActive Boolean @default(true) @map("is_active")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  parentCategory Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)

  subCategories Category[] @relation("CategoryHierarchy")

  products MasterProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([parentCategoryId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

// ======================================================
// BRANDS
// ======================================================

model Brand {
  id String @id @default(uuid()) @db.Uuid

  // Brand Information
  name String @db.VarChar(150)
  slug String @unique @db.VarChar(170)

  logoKey String? @map("logo_key") @db.VarChar(500)

  isActive Boolean @default(true) @map("is_active")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  products MasterProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([slug])
  @@index([isActive])
  @@map("brands")
}

// ======================================================
// UNITS
// ======================================================

model Unit {
  id String @id @default(uuid()) @db.Uuid

  // Unit Information
  name   String @unique @db.VarChar(100)
  symbol String @unique @db.VarChar(20)

  description String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  products MasterProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([isActive])
  @@map("units")
}

// ======================================================
// MASTER PRODUCTS
// ======================================================

model MasterProduct {
  id String @id @default(uuid()) @db.Uuid

  // Category & Brand
  categoryId String  @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid

  // Product Information
  name        String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)
  description String? @db.Text

  sku     String  @unique @db.VarChar(100)
  barcode String? @unique @db.VarChar(100)
  hsnCode String? @map("hsn_code") @db.VarChar(20)

  gstRate Decimal @default(0.00) @map("gst_rate") @db.Decimal(5, 2)

  unitValue Decimal @map("unit_value") @db.Decimal(10, 2)

  isVeg Boolean? @map("is_veg")

  isFeatured Boolean @default(false) @map("is_featured")

  status ProductStatus @default(ACTIVE)

  searchVector Unsupported("tsvector")?

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  images ProductImage[]

  storeProducts StoreProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
  @@index([sku])
  @@index([barcode])
  @@map("master_products")
}

// ======================================================
// PRODUCT IMAGES
// ======================================================

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  // Master Product
  masterProductId String @map("master_product_id") @db.Uuid

  // Image Information
  objectKey String @map("object_key") @db.VarChar(500)

  imageType ProductImageType @map("image_type")

