// ======================================================
// MODULE 3 ENUMS (Catalog & Inventory)
// ======================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED

  @@map("product_status")
}

enum ProductImageType {
  PRIMARY
  GALLERY

  @@map("product_image_type")
}

enum AvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
  DISCONTINUED

  @@map("availability_status")
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  RESTOCK
  ADJUSTMENT
  DAMAGE
  EXPIRED

  @@map("inventory_transaction_type")
}

enum InventoryReferenceType {
  ORDER
  PURCHASE
  RETURN
  MANUAL

  @@map("inventory_reference_type")
}

// ======================================================
// CATEGORIES
// ======================================================

model Category {
  id String @id @default(uuid()) @db.Uuid

  // Hierarchy
  parentCategoryId String? @map("parent_category_id") @db.Uuid

  // Category Information
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(170)
  description String? @db.Text

  imageKey String? @map("image_key") @db.VarChar(500)
  iconKey  String? @map("icon_key") @db.VarChar(500)

  sortOrder Int @default(0) @map("sort_order")

  isActive Boolean @default(true) @map("is_active")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  parentCategory Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)

  subCategories Category[] @relation("CategoryHierarchy")

  products MasterProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([parentCategoryId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

// ======================================================
// BRANDS
// ======================================================

model Brand {
  id String @id @default(uuid()) @db.Uuid

  // Brand Information
  name String @db.VarChar(150)
  slug String @unique @db.VarChar(170)

  logoKey String? @map("logo_key") @db.VarChar(500)

  isActive Boolean @default(true) @map("is_active")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  products MasterProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([slug])
  @@index([isActive])
  @@map("brands")
}

// ======================================================
// UNITS
// ======================================================

model Unit {
  id String @id @default(uuid()) @db.Uuid

  // Unit Information
  name   String @unique @db.VarChar(100)
  symbol String @unique @db.VarChar(20)

  description String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  products MasterProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([isActive])
  @@map("units")
}

// ======================================================
// MASTER PRODUCTS
// ======================================================

model MasterProduct {
  id String @id @default(uuid()) @db.Uuid

  // Category & Brand
  categoryId String  @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid

  // Product Information
  name        String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)
  description String? @db.Text

  sku     String  @unique @db.VarChar(100)
  barcode String? @unique @db.VarChar(100)
  hsnCode String? @map("hsn_code") @db.VarChar(20)

  gstRate Decimal @default(0.00) @map("gst_rate") @db.Decimal(5, 2)

  unitValue Decimal @map("unit_value") @db.Decimal(10, 2)

  isVeg Boolean? @map("is_veg")

  isFeatured Boolean @default(false) @map("is_featured")

  status ProductStatus @default(ACTIVE)

  searchVector Unsupported("tsvector")?

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  images ProductImage[]

  storeProducts StoreProduct[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
  @@index([sku])
  @@index([barcode])
  @@map("master_products")
}

// ======================================================
// PRODUCT IMAGES
// ======================================================

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  // Master Product
  masterProductId String @map("master_product_id") @db.Uuid

  // Image Information
  objectKey String @map("object_key") @db.VarChar(500)

  imageType ProductImageType @map("image_type")

  isPrimary Boolean @default(false) @map("is_primary")

  displayOrder Int @default(1) @map("display_order")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([masterProductId])
  @@index([masterProductId, displayOrder])
  @@index([masterProductId, isPrimary])
  @@map("product_images")
}

// ======================================================
// STORE PRODUCTS
// ======================================================

model StoreProduct {
  id String @id @default(uuid()) @db.Uuid

  // Store & Product
  storeId         String @map("store_id") @db.Uuid
  masterProductId String @map("master_product_id") @db.Uuid

  // Pricing
  mrp Decimal @db.Decimal(10, 2)

  sellingPrice Decimal @map("selling_price") @db.Decimal(10, 2)

  // Availability
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status")

  trackInventory Boolean @default(true) @map("track_inventory")

  isFeatured Boolean @default(false) @map("is_featured")

  displayOrder Int @default(0) @map("display_order")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  inventory Inventory?

  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  orderItems       OrderItem[]            @relation("OrderedProduct")
  replacementItems OrderItemReplacement[] @relation("ReplacementProduct")

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([storeId, masterProductId])
  @@index([storeId])
  @@index([masterProductId])
  @@index([availabilityStatus])
  @@index([isFeatured])
  @@index([storeId, availabilityStatus])
  @@index([storeId, isFeatured])
  @@map("store_products")
}

// ======================================================
// INVENTORY
// ======================================================

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  // Store Product
  storeProductId String @unique @map("store_product_id") @db.Uuid

  // Stock
  stockQuantity Int @default(0) @map("stock_quantity")

  reservedQuantity Int @default(0) @map("reserved_quantity")

  lowStockThreshold Int @default(10) @map("low_stock_threshold")

  reorderLevel Int @default(20) @map("reorder_level")

  version Int @default(0)

  lastStockUpdate DateTime? @map("last_stock_update") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  transactions InventoryTransaction[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([stockQuantity])
  @@index([lastStockUpdate])
  @@map("inventory")
}

// ======================================================
// INVENTORY TRANSACTIONS
// ======================================================

model InventoryTransaction {
  id String @id @default(uuid()) @db.Uuid

  // Inventory
  inventoryId String @map("inventory_id") @db.Uuid

  // Transaction
  transactionType InventoryTransactionType @map("transaction_type")

  quantity Int

  balanceAfterTransaction Int @map("balance_after_transaction")

  referenceType InventoryReferenceType? @map("reference_type")

  referenceId String? @map("reference_id") @db.Uuid

  source String? @db.VarChar(100)

  notes String? @db.Text

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([inventoryId])
  @@index([transactionType])
  @@index([referenceType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_transactions")
}
