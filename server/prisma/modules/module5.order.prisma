// ======================================================
// MODULE 5 - ORDER MANAGEMENT 
// ENUMS
// ======================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED

  @@map("order_status")
}

enum FulfillmentType {
  DELIVERY
  PICKUP

  @@map("fulfillment_type")
}

enum FulfillmentStatus {
  PENDING
  CONFIRMED
  REPLACED
  CANCELLED
  DELIVERED

  @@map("fulfillment_status")
}

enum ReplacementStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("replacement_status")
}

enum OrderNoteType {
  CUSTOMER
  MERCHANT
  SYSTEM
  DELIVERY_PARTNER

  @@map("order_note_type")
}

// ======================================================
// ORDERS
// ======================================================

model Order {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  userId    String @map("user_id") @db.Uuid
  storeId   String @map("store_id") @db.Uuid
  addressId String @map("address_id") @db.Uuid

  // Order Information
  orderNumber String @unique @map("order_number") @db.VarChar(50)

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  fulfillmentType FulfillmentType @default(DELIVERY) @map("fulfillment_type")

  // Pricing
  subtotal Decimal @default(0.00) @db.Decimal(10, 2)

  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(10, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(10, 2)

  deliveryFee Decimal @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)

  totalAmount Decimal @default(0.00) @map("total_amount") @db.Decimal(10, 2)

  // Delivery Address Snapshot
  deliveryReceiverName String @map("delivery_receiver_name") @db.VarChar(100)

  deliveryPhone String @map("delivery_phone") @db.VarChar(20)

  deliveryEmail String? @map("delivery_email") @db.VarChar(255)

  deliveryHouseNo String @map("delivery_house_no") @db.VarChar(100)

  deliveryStreet String @map("delivery_street") @db.VarChar(255)

  deliveryArea String @map("delivery_area") @db.VarChar(255)

  deliveryLandmark String? @map("delivery_landmark") @db.VarChar(255)

  deliveryCity String @map("delivery_city") @db.VarChar(100)

  deliveryState String @map("delivery_state") @db.VarChar(100)

  deliveryCountry String @map("delivery_country") @db.VarChar(100)

  deliveryPincode String @map("delivery_pincode") @db.VarChar(20)

  deliveryLatitude Decimal? @map("delivery_latitude") @db.Decimal(10, 7)

  deliveryLongitude Decimal? @map("delivery_longitude") @db.Decimal(10, 7)

  // Customer Instructions
  deliveryInstructions String? @map("delivery_instructions") @db.Text

  // Timeline
  placedAt DateTime @default(now()) @map("placed_at") @db.Timestamptz(6)

  version Int @default(0)

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  packedAt DateTime? @map("packed_at") @db.Timestamptz(6)

  outForDeliveryAt DateTime? @map("out_for_delivery_at") @db.Timestamptz(6)

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  items OrderItem[]

  statusHistory OrderStatusHistory[]

  notes OrderNote[]

  payment Payment?

  financialDocuments FinancialDocument[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([userId, status])
  @@index([storeId, status])
  @@index([userId, placedAt])
  @@map("orders")
}

// ======================================================
// ORDER ITEMS
// ======================================================

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  orderId String @map("order_id") @db.Uuid

  storeProductId String @map("store_product_id") @db.Uuid

  // Quantity
  quantity Int

  // Product Snapshot
  productNameSnapshot String @map("product_name_snapshot") @db.VarChar(200)

  unitSnapshot String @map("unit_snapshot") @db.VarChar(50)

  // Pricing Snapshot
  mrpSnapshot Decimal @map("mrp_snapshot") @db.Decimal(10, 2)

  sellingPriceSnapshot Decimal @map("selling_price_snapshot") @db.Decimal(10, 2)

  gstRateSnapshot Decimal @map("gst_rate_snapshot") @db.Decimal(5, 2)

  subtotal Decimal @db.Decimal(10, 2)

  // Fulfillment
  fulfillmentStatus FulfillmentStatus @default(PENDING) @map("fulfillment_status")

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  storeProduct StoreProduct @relation("OrderedProduct", fields: [storeProductId], references: [id], onDelete: Restrict)

  replacements OrderItemReplacement[]

  // ======================================================
  // Constraints
  // ======================================================

  @@index([orderId])
  @@index([orderId, fulfillmentStatus])
  @@map("order_items")
}

// ======================================================
// ORDER ITEM REPLACEMENTS
// ======================================================

model OrderItemReplacement {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  orderItemId String @map("order_item_id") @db.Uuid

  replacementStoreProductId String @map("replacement_store_product_id") @db.Uuid

  // Status
  status ReplacementStatus @default(PENDING)

  // Replacement Product Snapshot
  replacementProductNameSnapshot String @map("replacement_product_name_snapshot") @db.VarChar(200)

  replacementUnitSnapshot String @map("replacement_unit_snapshot") @db.VarChar(50)

  replacementMrpSnapshot Decimal @map("replacement_mrp_snapshot") @db.Decimal(10, 2)

  replacementSellingPriceSnapshot Decimal @map("replacement_selling_price_snapshot") @db.Decimal(10, 2)

  replacementGstRateSnapshot Decimal @map("replacement_gst_rate_snapshot") @db.Decimal(5, 2)

  replacementSubtotal Decimal @map("replacement_subtotal") @db.Decimal(10, 2)

  // Merchant & Customer Communication
  merchantReason String? @map("merchant_reason") @db.Text

  customerResponse String? @map("customer_response") @db.Text

  // Timeline
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)

  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  replacementStoreProduct StoreProduct @relation("ReplacementProduct", fields: [replacementStoreProductId], references: [id], onDelete: Restrict)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([orderItemId])
  @@index([orderItemId, status])
  @@map("order_item_replacements")
}

// ======================================================
// ORDER STATUS HISTORY
// ======================================================

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  orderId String @map("order_id") @db.Uuid

  // Status Transition
  previousStatus OrderStatus? @map("previous_status")

  newStatus OrderStatus @map("new_status")

  // Additional Information
  remarks String? @db.Text

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([orderId])
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ======================================================
// ORDER NOTES
// ======================================================

model OrderNote {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  orderId String @map("order_id") @db.Uuid

  // Note
  noteType OrderNoteType @map("note_type")

  note String @db.Text

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([orderId])
  @@index([orderId, createdAt])
  @@map("order_notes")
}
