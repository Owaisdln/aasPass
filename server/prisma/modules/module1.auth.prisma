// ======================================================
// MODULE 1 - IDENTITY & ACCESS MANAGEMENT
// ENUMS
// ======================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING_VERIFICATION

  @@map("user_status")
}

enum OTPPurpose {
  ORDER_DELIVERY
  ORDER_PICKUP
  ACCOUNT_RECOVERY
  SENSITIVE_ACTION

  @@map("otp_purpose")
}

enum OTPChannel {
  SMS
  EMAIL

  @@map("otp_channel")
}

// Distinguishes what kind of business entity referenceId points to.
// Not every OTPPurpose needs one (e.g. ACCOUNT_RECOVERY has no business
// entity — it's about the user themselves, already captured by userId) —
// referenceType/referenceId stay nullable in BusinessOTP for that reason.
enum BusinessOTPReferenceType {
  ORDER
  ACCOUNT

  @@map("business_otp_reference_type")
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  WEB

  @@map("device_type")
}

enum RevocationReason {
  LOGOUT
  PASSWORD_CHANGED
  TOKEN_ROTATED
  ACCOUNT_LOCKED
  SECURITY
  EXPIRED

  @@map("revocation_reason")
}

// ======================================================
// ROLES
// ======================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  // Indexes
  @@index([isActive])
  @@map("roles")
}

// ======================================================
// PERMISSIONS
// ======================================================

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  // Indexes
  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

// ======================================================
// ROLE PERMISSIONS
// ======================================================

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([roleId, permissionId])
  // Indexes
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ======================================================
// USERS
// ======================================================

model User {
  id String @id @db.Uuid

  // Role
  roleId String @map("role_id") @db.Uuid

  // Basic Information
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)

  // Authentication
  phone String? @db.VarChar(15)
  email String? @db.VarChar(255)

  // Account Status
  status UserStatus @default(PENDING_VERIFICATION)

  // Verification (Synced from Supabase)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  // User Activity
  lastSeenAt DateTime? @map("last_seen_at")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ======================================================
  // Relations
  // ======================================================

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  addresses    Address[]
  businessOtps BusinessOTP[]
  sessions     UserSession[]

  ownedStore     Store?  @relation("StoreOwner")
  verifiedStores Store[] @relation("StoreVerifier")

  carts     Cart[]
  wishlists Wishlist[]
  orders    Order[]

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([phone])
  @@unique([email])
  @@index([roleId])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("users")
}

// ======================================================
// ADDRESSES
// ======================================================

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  label String? @db.VarChar(50)

  receiverName  String @map("receiver_name") @db.VarChar(100)
  receiverPhone String @map("receiver_phone") @db.VarChar(15)

  houseNo  String  @map("house_no") @db.VarChar(100)
  street   String? @db.VarChar(255)
  area     String  @db.VarChar(255)
  landmark String? @db.VarChar(255)

  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  country String @db.VarChar(100)
  pincode String @db.VarChar(10)

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  isDefault Boolean @default(false) @map("is_default")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([userId, isDefault])
  @@index([city])
  @@index([pincode])
  @@map("addresses")
}

// ======================================================
// BUSINESS OTPS
// ======================================================

model BusinessOTP {
  id String @id @default(uuid()) @db.Uuid

  // User (Optional)
  userId String? @map("user_id") @db.Uuid

  // Business Entity Reference (Order, Delivery, etc.) — nullable since not
  // every purpose has one (e.g. ACCOUNT_RECOVERY references the user only)
  referenceType BusinessOTPReferenceType? @map("reference_type")
  referenceId   String?                   @map("reference_id") @db.Uuid

  // OTP Details
  purpose OTPPurpose
  channel OTPChannel

  destination String @db.VarChar(255)

  otpHash String @map("otp_hash") @db.VarChar(255)

  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")

  lastAttemptAt DateTime? @map("last_attempt_at")
  blockedUntil  DateTime? @map("blocked_until")

  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  consumedAt DateTime? @map("consumed_at")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ======================================================
  // Relations
  // ======================================================

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([referenceType, referenceId])
  @@index([purpose])
  @@index([channel])
  @@index([destination])
  @@index([expiresAt])
  @@map("business_otps")
}

// ======================================================
// USER SESSIONS
// ======================================================

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  deviceType DeviceType @map("device_type")
  deviceName String?    @map("device_name") @db.VarChar(255)
  deviceId   String?    @map("device_id") @db.VarChar(255)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  revokedAt        DateTime?         @map("revoked_at")
  revocationReason RevocationReason? @map("revocation_reason")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([userId, deviceId])
  @@index([lastActivityAt])
  @@index([revokedAt])
  @@map("user_sessions")
}
