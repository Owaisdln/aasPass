// ======================================================
// MODULE 4 - ENUMS
// ======================================================

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED

  @@map("cart_status")
}

// ======================================================
// CARTS
// ======================================================

model Cart {
  id String @id @default(uuid()) @db.Uuid

  // Owner
  userId String @map("user_id") @db.Uuid

  // One Cart = One Store
  storeId String @map("store_id") @db.Uuid

  // Status
  status CartStatus @default(ACTIVE)

  // Pricing
  subtotal Decimal @default(0.00) @db.Decimal(10, 2)

  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(10, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(10, 2)

  deliveryFee Decimal @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)

  totalAmount Decimal @default(0.00) @map("total_amount") @db.Decimal(10, 2)

  // Customer Notes
  notes String? @db.Text

  // Expiration
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  items CartItem[]

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status])
  @@index([storeId, status])
  @@map("carts")
}

// ======================================================
// CART ITEMS
// ======================================================

model CartItem {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  cartId String @map("cart_id") @db.Uuid

  storeProductId String @map("store_product_id") @db.Uuid

  // Quantity
  quantity Int

  // Product Snapshot
  productNameSnapshot String @map("product_name_snapshot") @db.VarChar(200)

  unitSnapshot String @map("unit_snapshot") @db.VarChar(50)

  // Pricing Snapshot
  mrpSnapshot Decimal @map("mrp_snapshot") @db.Decimal(10, 2)

  sellingPriceSnapshot Decimal @map("selling_price_snapshot") @db.Decimal(10, 2)

  gstRateSnapshot Decimal @map("gst_rate_snapshot") @db.Decimal(5, 2)

  subtotal Decimal @db.Decimal(10, 2)

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Restrict)

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([cartId, storeProductId])
  @@index([cartId])
  @@index([cartId, storeProductId])
  @@map("cart_items")
}

// ======================================================
// WISHLISTS
// ======================================================

model Wishlist {
  id String @id @default(uuid()) @db.Uuid

  // Owner
  userId String @map("user_id") @db.Uuid

  // Wishlist Information
  name String @db.VarChar(100)

  isDefault Boolean @default(false) @map("is_default")

  // Audit
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("wishlists")
}

// ======================================================
// WISHLIST ITEMS
// ======================================================

model WishlistItem {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  wishlistId String @map("wishlist_id") @db.Uuid

  storeProductId String @map("store_product_id") @db.Uuid

  // Audit
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Restrict)

  // ======================================================
  // Constraints
  // ======================================================

  // ======================================================
  // Indexes
  // ======================================================

  @@unique([wishlistId, storeProductId])
  @@index([wishlistId])
  @@map("wishlist_items")
}
